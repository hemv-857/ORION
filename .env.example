# ============================================
# ORION — Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values you need.
#
#   cp .env.example .env.local
#
# The dashboard works without any keys — all data sources have public
# fallbacks or cached defaults. Set keys only for features you want live.
# ============================================


# ------ LLM (required for Country Brief and AI features) ------

# Groq API (primary — free tier: 14,400 req/day)
# Get yours at: https://console.groq.com/
GROQ_API_KEY=

# OpenRouter API (fallback — free tier: 50 req/day)
# Get yours at: https://openrouter.ai/
OPENROUTER_API_KEY=


# ------ Market Data ------

# Finnhub (stock quotes — has built-in fallback key)
# Register at: https://finnhub.io/
FINNHUB_API_KEY=


# ------ Energy Data ------

# U.S. EIA (oil prices, production, inventory — has built-in fallback key)
# Register at: https://www.eia.gov/opendata/
EIA_API_KEY=


# ------ Economic Data ------

# FRED (Federal Reserve — has built-in fallback key)
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# IMF SDMX API (WEO, national debt — optional, works unauthenticated)
# Register at: https://portal.api.imf.org/
IMF_API_KEY=


# ------ Conflict & Protest Data ------

# ACLED (Armed Conflict data — free for researchers)
# Register at: https://acleddata.com/
ACLED_EMAIL=
ACLED_PASSWORD=
ACLED_ACCESS_TOKEN=

# UCDP (Uppsala Conflict Data Program)
# Register at: https://ucdp.uu.se/apidocs/
UCDP_ACCESS_TOKEN=


# ------ Aviation ------

# AviationStack (live flight data)
# Register at: https://aviationstack.com/
AVIATIONSTACK_API=


# ------ Internet Outages ------

# Cloudflare Radar API
CLOUDFLARE_API_TOKEN=


# ------ Satellite Fire Detection ------

# NASA FIRMS
# Register at: https://firms.modaps.eosdis.nasa.gov/
NASA_FIRMS_API_KEY=


# ------ Air Quality ------

# OpenAQ API v3
# Register at: https://docs.openaq.org/using-the-api/api-key
OPENAQ_API_KEY=


# ------ Web Scraping / Search ------

# Exa neural search
# Register at: https://exa.ai/
EXA_API_KEYS=

# Brave Search
# Register at: https://brave.com/search/api/
BRAVE_API_KEYS=


# ------ Convex (database) ------

# Convex deployment URL
# Set up at: https://dashboard.convex.dev/
CONVEX_URL=

# Convex HTTP actions base URL
# Example: https://happy-animal-123.convex.site
CONVEX_SITE_URL=


# ------ Render Relay (ais-relay.cjs) ------

# AISStream API key for live vessel positions
# Get yours at: https://aisstream.io/
AISSTREAM_API_KEY=

# OpenSky Network OAuth2 (higher rate limits)
# Register at: https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Reddit data (social-velocity, WSB tickers)
SCRAPECREATORS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Telegram MTProto (free): https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHANNEL_SET=full


# ------ Self-Hosted LLM (Docker) ------

# Point to your own LLM server (Ollama, vLLM, llama.cpp, etc.)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=


# ------ Relay Connection (Vercel → Render) ------

# Server-side relay URL
WS_RELAY_URL=

# Client-side relay URL (wss:// — local/dev fallback)
VITE_WS_RELAY_URL=

# Shared relay auth secret
# Generate: openssl rand -hex 32
RELAY_SHARED_SECRET=

# Header name for relay auth
RELAY_AUTH_HEADER=x-relay-key


# ------ Site Configuration ------

# API base URL for web redirect (leave empty for same-domain)
# Production: https://api.orion.app
VITE_WS_API_URL=

# Sentry DSN (optional)
VITE_SENTRY_DSN=

# Map tiles (optional PMTiles URL — leave empty for OpenFreeMap)
VITE_PMTILES_URL=


# ------ Notification Delivery ------

# Telegram bot for push notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Email notifications (Resend)
# Register at: https://resend.com/
RESEND_API_KEY=
RESEND_FROM_EMAIL=ORION <alerts@orion.app>


# ------ Auth & Signing ------

# Cloudflare Turnstile (CAPTCHA verification)
TURNSTILE_SECRET_KEY=

# Session cookie signing key
# Generate: openssl rand -hex 32
ORION_SESSION_SECRET=


# ------ ORION Internal Keys ------

# API key for seed/verification scripts
ORION_API_KEY=

# Base URL for shareable brief links
ORION_PUBLIC_BASE_URL=
